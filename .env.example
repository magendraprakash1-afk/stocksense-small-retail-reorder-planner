# StockSense Management — Environment Variables
# Copy to .env and fill in your values

# ── Database ──
DATABASE_URL=postgresql+asyncpg://stocksense:stocksense@localhost:5432/stocksense_db
DATABASE_URL_SYNC=postgresql://stocksense:stocksense@localhost:5432/stocksense_db

# ── JWT Authentication ──
SECRET_KEY=change-this-to-a-random-64-character-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application ──
APP_NAME=StockSense Management
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# ── Forecasting Defaults ──
DEFAULT_FORECAST_HORIZON_DAYS=14
DEFAULT_SAFETY_STOCK_DAYS=3
DEFAULT_REVIEW_PERIOD_DAYS=7
DEFAULT_SERVICE_LEVEL=0.95

# ── Server ──
HOST=0.0.0.0
PORT=8000
